FROM ubuntu:stonking

RUN \
    export DEBIAN_FRONTEND=noninteractive \
 && apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y build-essential \
        autoconf \
        automake \
        autopoint \
        bash \
        bison \
        bzip2 \
        clang \
        flex \
        g++-16 \
        gettext \
        git \
        gperf \
        intltool \
        libc6-dev-i386 \
        libclang-dev \
        libgdk-pixbuf-2.0-dev \
        libltdl-dev \
        libgl-dev \
        libpcre2-dev \
        libssl-dev \
        libtool-bin \
        libxml-parser-perl \
        llvm-dev \
        lzip \
        make \
        openssl \
        p7zip-full \
        patch \
        perl \
        python3 \
        python3-mako \
        python3-yaml \
        python3-packaging \
        python3-pkg-resources \
        python3-setuptools \
        python-is-python3 \
        ruby \
        sed \
        sqlite3 \
        unzip \
        wget \
        xz-utils \
 && cd /opt/ \
 && git clone https://github.com/mxe/mxe.git \
 && cd mxe \
 && git checkout bdc0e9e2cf878d64086a6f3b51bc443d4c5ebb9c \
 && make qt6 --jobs=15 JOBS=4 MXE_PLUGIN_DIRS=plugins/gcc16 \
 && rm -rf /var/lib/apt/lists/*

RUN cd /opt/mxe && make clean-junk

ENV PATH="$PATH:/opt/mxe/usr/bin"
